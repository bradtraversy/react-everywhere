{
  "name": "@react-everywhere/terminal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "react-everywhere": "dist/cli.js"
  },
  "scripts": {
    "build": "esbuild src/cli.jsx --bundle --platform=node --format=esm --jsx=automatic --packages=external --outfile=dist/cli.js",
    "start": "node dist/cli.js",
    "dev": "npm run build && node dist/cli.js"
  },
  "dependencies": {
    "@react-everywhere/logic": "*",
    "ink": "^7.1.1",
    "react": "^19.2.8"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
