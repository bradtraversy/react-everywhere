{
  "name": "react-everywhere",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "One React hook. Every renderer. Zero edits to the logic.",
  "author": {
    "name": "Brad Traversy"
  },
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "web": "npm run dev -w @react-everywhere/web",
    "electron": "npm run dev -w @react-everywhere/electron",
    "mobile": "npm run start -w @react-everywhere/mobile",
    "terminal": "npm run dev -w @react-everywhere/terminal",
    "three": "npm run dev -w @react-everywhere/three",
    "video": "npm run dev -w @react-everywhere/video",
    "video:render": "npm run render -w @react-everywhere/video"
  }
}
